	)
	(text "Original designators: V1=Rö1 (ECC83), V2=Rö2 (ECC81), V3..V8=Rö3..Rö8 (EL34), T1=Ü1 (E-1220), T2=Ü2.\nSupply rails A1/G1/M1, A2/G2/M2 and UG1/UG2 come from the power supply sheet.\nUpper tubes: anode A1, screen G1, cathode M1 (G1 is referenced to M1).\nLower tubes: anode A2, screen G2, cathode M2 (G2 is referenced to M2).\nUg1/Ug2: bias windings, floating on M1/M2; bias adjust P1..P6."
		(exclude_from_sim no)
		(at 187.96 345.44 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "1f5f1573-3e36-43ab-81be-5112f6c70655")
	)
